    {
      "id": "pattern_079",
      "number": "079",
      "title": "来得及",
      "formula": "来得及/来不及 + 动词",
      "introduction": "表示时间够不够。",
      "example": "现在还来得及。",
      "teaching_type": "complement",
      "difficulty": "hard",
      "focus_tags": [
        "得"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_158",
      "number": "158",
      "title": "能否承受或完成",
      "formula": "动词 + 得了/不了 + 宾语/小句",
      "introduction": "读liǎo，表示能不能完成、承受或处理；“受得了/受不了”很常用。",
      "example": "这么多我吃不了。",
      "teaching_type": "complement",
      "difficulty": "hard",
      "focus_tags": [
        "了",
        "得"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_191",
      "number": "191",
      "title": "负担得起",
      "formula": "动词 + 得起/不起 + 宾语",
      "introduction": "表示经济、能力或条件上能不能承担，最常见的是“买得起/买不起”。",
      "example": "我买不起这个。",
      "teaching_type": "complement",
      "difficulty": "hard",
      "focus_tags": [
        "得"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_320",
      "number": "320",
      "title": "可能动",
      "formula": "动词 + 得/不 + 动",
      "introduction": "表示有无力气让人或东西移动。",
      "example": "我搬不动箱子。",
      "teaching_type": "complement",
      "difficulty": "hard",
      "focus_tags": [
        "得"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_321",
      "number": "321",
      "title": "方向可能补语",
      "formula": "动词 + 得/不 + 进来/出去/回来/过去",
