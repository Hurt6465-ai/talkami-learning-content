      "example": "我马上回来。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了",
        "就"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_179",
      "number": "179",
      "title": "刚",
      "formula": "主语 + 刚 + 动词",
      "introduction": "表示刚刚发生，通常不用句末“了”。",
      "example": "我刚到。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_181",
      "number": "181",
      "title": "刚才",
      "formula": "主语 + 刚才 + 动词 + 了",
      "introduction": "“刚才”是时间名词，可搭配“了”。",
      "example": "我刚才给你打电话了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了",
        "才"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_182",
      "number": "182",
      "title": "一直",
      "formula": "主语 + 一直 + 动词/形容词",
      "introduction": "表示动作或状态一直没有停止。",
