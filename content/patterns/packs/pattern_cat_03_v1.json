  "items": [
    {
      "id": "pattern_338",
      "number": "338",
      "title": "一下子",
      "formula": "一下子 + 动词/形容词 + 了",
      "introduction": "表示事情突然、很快发生。",
      "example": "他一下子笑了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_163",
      "number": "163",
      "title": "尽量……",
      "formula": "主语 + 尽量 + 动词",
      "introduction": "表示在条件允许的范围内努力做到。",
      "example": "请尽量早点来。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_177",
      "number": "177",
      "title": "才……就……",
      "formula": "主语 + 才 + 时间/数量 + 就 + 动词",
      "introduction": "表示时间很早、数量很少，事情就发生了，常带意外。",
      "example": "他才八点就来了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "才",
        "就"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_022",
      "number": "022",
      "title": "时间在主语后",
      "formula": "主语 + 时间 + 动词",
      "introduction": "最常见时间位置。",
      "example": "我明天上班。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "在",
        "语序"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_023",
      "number": "023",
      "title": "时间在句首",
      "formula": "时间 + 主语 + 动词",
      "introduction": "强调时间或承接上下文。",
      "example": "明天我不上班。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "在",
        "语序"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_024",
      "number": "024",
      "title": "地点状语",
      "formula": "主语 + 在 + 地点 + 动词",
      "introduction": "先说“在哪里”，再说动作。",
      "example": "我在家吃饭。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "在",
        "语序"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_025",
      "number": "025",
      "title": "太…了",
      "formula": "太 + 形容词 + 了",
      "introduction": "表示程度很高，可以夸奖，也可以抱怨。",
      "example": "太贵了。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_031",
      "number": "031",
      "title": "也",
      "formula": "主语 + 也 + 动词/形容词",
      "introduction": "放在后面的说明前。",
      "example": "我也喜欢。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_032",
      "number": "032",
      "title": "都",
      "formula": "复数主语/范围 + 都 + 谓语",
      "introduction": "表示范围内全部。",
      "example": "我们都知道。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_033",
      "number": "033",
      "title": "一起",
      "formula": "主语 + 跟/和 + 人 + 一起 + 动词",
      "introduction": "“一起”通常在动词前。",
      "example": "我跟朋友一起吃饭。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_156",
      "number": "156",
      "title": "时间地点顺序",
      "formula": "主语 + 时间 + 在 + 地点 + 动词",
      "introduction": "通常“时间在地点前”。",
      "example": "我明天在家休息。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "在",
        "语序"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_162",
      "number": "162",
      "title": "动作方式",
      "formula": "主语 + 副词 + 动词",
      "introduction": "副词放在动词前。",
      "example": "请慢慢说。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_164",
      "number": "164",
      "title": "稍微",
      "formula": "主语 + 有点儿 + 形容词",
      "introduction": "常用于不太理想的情况。",
      "example": "我有点儿累。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_165",
      "number": "165",
      "title": "一点儿",
      "formula": "动词/形容词 + 一点儿",
      "introduction": "放在形容词或动词后。",
      "example": "请慢一点儿。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_166",
      "number": "166",
      "title": "不太",
      "formula": "主语 + 不太 + 形容词/动词",
      "introduction": "委婉否定。",
      "example": "我不太明白。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_168",
      "number": "168",
      "title": "还",
      "formula": "主语 + 还 + 动词/形容词",
      "introduction": "表示继续、补充或尚未。",
      "example": "他还在睡觉。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_169",
      "number": "169",
      "title": "只",
      "formula": "主语 + 只 + 动词/数量",
      "introduction": "表示限制。",
      "example": "我只喝水。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_170",
      "number": "170",
      "title": "才",
      "formula": "主语 + 才 + 动词",
      "introduction": "表示晚、少或条件严格。",
      "example": "他十点才来。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "才"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_172",
      "number": "172",
      "title": "就",
      "formula": "主语 + 就 + 动词",
      "introduction": "表示早、快或自然结果。",
      "example": "他八点就来了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "就"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_174",
      "number": "174",
      "title": "已经",
      "formula": "主语 + 已经 + 动词 + 了",
      "introduction": "“已经”常和“了”搭配。",
      "example": "我已经吃饭了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_178",
      "number": "178",
      "title": "马上",
      "formula": "主语 + 马上 + 动词 / 就要 + 动词 + 了",
