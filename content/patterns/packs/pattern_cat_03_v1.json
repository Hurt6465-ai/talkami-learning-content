      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_183",
      "number": "183",
      "title": "常常",
      "formula": "主语 + 常常/经常 + 动词",
