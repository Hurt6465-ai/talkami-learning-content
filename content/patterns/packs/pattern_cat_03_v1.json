      "example": "我经常运动。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_184",
      "number": "184",
      "title": "有时候",
      "formula": "主语 + 有时候 + 动词",
      "introduction": "表示不固定频率。",
      "example": "我有时候自己做饭。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_201",
      "number": "201",
      "title": "又",
      "formula": "主语 + 又 + 动词/形容词 + 了",
      "introduction": "表示已发生的重复。",
      "example": "他又迟到了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了",
        "又"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_202",
      "number": "202",
      "title": "再",
      "formula": "主语 + 再 + 动词",
      "introduction": "表示未来或未发生的重复。",
      "example": "请再试一次。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "再"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_205",
      "number": "205",
      "title": "差不多",
      "formula": "主语 + 差不多 + 动词/形容词/数量",
      "introduction": "表示接近或相似。",
      "example": "我们差不多到了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_206",
      "number": "206",
      "title": "终于",
      "formula": "主语 + 终于 + 动词 + 了",
      "introduction": "表示经过等待后实现。",
      "example": "我终于找到你了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_381",
      "number": "381",
      "title": "一…就…",
      "formula": "一 + 动词1 + 就 + 动词2",
      "introduction": "表示两个动作紧接发生。",
      "example": "我一到家就睡觉。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "就"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_379",
      "number": "379",
      "title": "事情发生在",
      "formula": "事情 + 发生在 + 时间/地点",
      "introduction": "说明事件发生的时间或地点，“发生在”比“在……发生”更自然。",
      "example": "事故发生在晚上。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "在"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_175",
      "number": "175",
      "title": "早就……了",
      "formula": "主语 + 早就 + 动词 + 了",
      "introduction": "表示事情比现在早很多就已经发生。",
      "example": "我早就知道了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了",
        "就"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_203",
      "number": "203",
      "title": "顺便",
      "formula": "主语 + 顺便 + 动词",
      "introduction": "做主要事情时，同时做另一件方便的小事。",
      "example": "我顺便买点儿菜。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_080",
      "number": "080",
      "title": "先……再/然后……",
      "formula": "先 + 动词1，再/然后 + 动词2",
      "introduction": "清楚说明两个动作的先后顺序。",
      "example": "先洗手，再吃饭。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "再"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_099",
      "number": "099",
      "title": "然后和接着",
      "formula": "然后/接着 + 小句",
      "introduction": "都表示下一步；“接着”更强调紧接着继续。",
      "example": "然后我回家了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "着"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_119",
      "number": "119",
      "title": "最后",
      "formula": "最后 + 小句",
      "introduction": "说明过程的最后一步或最终结果。",
      "example": "最后我同意了。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_185",
      "number": "185",
      "title": "还要",
      "formula": "主语 + 还要 + 名词/动词",
      "introduction": "表示除了已有的，还需要或还要做。",
      "example": "我还要一杯水。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_258",
      "number": "258",
      "title": "只好",
      "formula": "主语 + 只好 + 动词",
      "introduction": "没有更好办法，只能这样做。",
      "example": "我只好回家。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_285",
      "number": "285",
      "title": "还会",
      "formula": "主语 + 还会 + 动词",
      "introduction": "表示除了前面说的能力，还有另一项。",
      "example": "她还会唱歌。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_312",
      "number": "312",
      "title": "再也不",
      "formula": "主语 + 再也不 + 动词 + 了",
      "introduction": "表示以后永远不再做。",
      "example": "我再也不迟到了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了",
        "再"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_440",
      "number": "440",
      "title": "差不多该",
      "formula": "差不多该 + 动词 + 了",
      "introduction": "表示时间快到了，应该开始做了。",
      "example": "我们差不多该走了。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    }
  ]
}
