      "title": "အိမ်ရှာ/အိမ်ကြည့်ခြင်း",
      "zh": "找房看房",
      "functions": [
        "寻找房源",
        "确认位置和设施"
      ],
      "teach": "租房、房子、房间、附近、地铁、家具、看房、合租；筛选住处。",
      "say": [
        "我想租房。",
        "有一室一厅吗？",
        "离地铁近吗？",
        "可以看房吗？",
        "家具齐吗？",
        "可以合租吗？"
      ],
      "patterns": [
        {
          "zh": "寻找房源",
          "form": "有房出租吗？/ 想租……",
          "ex": "有房出租吗？"
        },
        {
          "zh": "确认位置",
          "form": "离地铁远吗？/ 附近方便吗？",
          "ex": "离地铁远吗？"
        }
      ],
      "grammar": [
        {
          "point": "“有没有＋房型/条件”",
          "note": "找房时询问房源：有一室一厅吗？"
        }
      ],
      "variants": "找房：有房出租吗？/ 想租……；位置：离地铁远吗？/ 附近方便吗？",
      "listen": [
        "今天可以看。",
        "离地铁十分钟。",
        "家具都有。",
        "不能养宠物。"
      ],
      "events": [
        "对方说“不能养宠物。”，学习者要听懂后处理。",
        "对方改用“离地铁十分钟。”，学习者要能听懂并自然回应。"
      ],
      "roles": "租客 ↔ 房东/中介",
      "task": "问清位置、户型、基本设施并预约看房。"
    },
