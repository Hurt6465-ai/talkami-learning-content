{
  "v": 2,
  "id": "54",
  "title": "အလုပ်တာဝန်နှင့် အစည်းအဝေး",
  "zh": "任务会议",
  "scenes": [
    {
      "id": "54.1",
      "title": "အလုပ်တာဝန်လက်ခံခြင်း",
      "zh": "接收任务",
      "functions": [
        "确认任务内容",
        "确认任务范围"
      ],
      "teach": "任务、负责、今天、本周、目标、资料、客户、完成；明确“谁做什么”。",
      "say": [
        "这个谁负责？",
        "是我做吗？",
        "今天要完成什么？",
        "需要哪些资料？",
        "我负责这一部分。",
        "什么时候要？"
      ],
      "patterns": [
        {
          "zh": "确认任务内容",
          "form": "这个是我负责吗？/ 我要做哪些？",
          "ex": "这个是我负责吗？"
        },
        {
          "zh": "确认任务范围",
          "form": "只做这个吗？/ 还有别的吗？",
          "ex": "只做这个吗？"
        }
      ],
      "grammar": [
        {
          "point": "“负责＋任务”",
          "note": "说明任务归属：这个我负责。"
        }
      ],
      "variants": "确认任务：这个是我负责吗？/ 我要做哪些？；范围：只做这个吗？/ 还有别的吗？",
      "listen": [
        "这部分你负责。",
        "今天先做前三项。",
        "资料发你了。",
        "有问题马上说。"
      ],
      "events": [
        "对方说“今天先做前三项。”，学习者要听懂后处理。",
        "对方改用“有问题马上说。”，学习者要能听懂并自然回应。"
      ],
      "roles": "员工 ↔ 主管/同事/人事",
      "task": "接到任务后确认范围、资料和期限。"
    },
    {
      "id": "54.2",
      "title": "တိုးတက်မှုနှင့် နောက်ဆုံးရက်",
      "zh": "进度截止",
      "functions": [
        "查询进度",
        "确认期限"
      ],
      "teach": "进度、截止、完成、还差、今天、明天、提前、来不及；管理时间。",
      "say": [
        "做到哪儿了？",
        "什么时候完成？",
        "今天能做完吗？",
        "还差一点。",
        "可能来不及。",
        "我明早给你。"
      ],
      "patterns": [
        {
          "zh": "查询进度",
          "form": "做到哪了？/ 好了吗？",
          "ex": "做到哪了？"
        },
        {
          "zh": "确认期限",
          "form": "最晚什么时候？/ 截止到几点？",
          "ex": "最晚什么时候？"
        }
      ],
      "grammar": [
        {
          "point": "“最晚/之前”",
          "note": "用于明确截止时间。"
        }
      ],
      "variants": "问进度：做到哪了？/ 好了吗？；期限：最晚什么时候？/ 截止到几点？",
      "listen": [
        "今天下班前。",
        "已经完成一半。",
        "还差最后一部分。",
        "不能再晚了。"
      ],
      "events": [
        "对方说“不能再晚了。”，学习者要听懂后处理。",
        "对方改用“还差最后一部分。”，学习者要能听懂并自然回应。"
      ],
      "roles": "员工 ↔ 主管/同事/人事",
      "task": "汇报真实进度并在可能延期时提前说明。"
    },
    {
      "id": "54.3",
      "title": "အစည်းအဝေးတွင် ပြောခြင်း",
      "zh": "会议发言",
      "functions": [
        "会议发言",
        "表达意见",
        "结束发言"
      ],
      "teach": "开会、开始、意见、问题、同意、补充、建议、总结；短句参与会议。",
      "say": [
        "我同意。",
        "我有一个问题。",
        "我补充一下。",
        "我建议这样做。",
        "这部分我负责。",
        "我没有问题。"
      ],
      "patterns": [
        {
          "zh": "会议发言",
          "form": "我说一下 / 我补充一点",
          "ex": "我说一下。"
        },
        {
          "zh": "表达意见",
          "form": "我觉得…… / 我建议……",
          "ex": "我建议这样做。"
        },
        {
          "zh": "结束发言",
          "form": "我说完了。",
          "ex": "我说完了。"
        }
      ],
      "grammar": [
        {
          "point": "“我觉得/我建议”",
          "note": "会议里先用短框架表达观点。"
        }
      ],
      "variants": "发言：我说一下 / 我补充一点；意见：我觉得…… / 我建议……；结束：我说完了。",
      "listen": [
        "大家有什么意见？",
        "你这边呢？",
        "还有问题吗？",
        "那就这么定。"
      ],
      "events": [
        "对方说“还有问题吗？”，学习者要听懂后处理。",
        "对方改用“大家有什么意见？”，学习者要能听懂并自然回应。"
      ],
      "roles": "员工 ↔ 主管/同事/人事",
      "task": "在会议中至少主动发言一次并做清晰回应。"
    },
    {
      "id": "54.4",
      "title": "ဖိုင်နှင့် အချက်အလက်ပေးပို့ခြင်း",
      "zh": "文件信息传达",
      "functions": [
        "发送文件",
        "确认版本/修改要求"
      ],
      "teach": "文件、表格、照片、版本、发、收到、修改、确认；办公室与现场都通用。",
      "say": [
        "文件发你了。",
        "你收到了吗？",
        "这是最新版。",
        "这里要改。",
        "改完发给我。",
        "我确认一下。"
      ],
      "patterns": [
        {
          "zh": "发送文件",
          "form": "我发你微信/邮箱了",
          "ex": "我发你微信。"
        },
        {
          "zh": "确认修改要求",
          "form": "这里改一下 / 按这个版本做。",
          "ex": "这里改一下。"
        }
      ],
      "grammar": [
        {
          "point": "“发给/转给＋人”",
          "note": "传达文件和信息。"
        }
      ],
      "variants": "发送：我发你微信/邮箱了；修改：这里改一下 / 按这个版本做。",
      "listen": [
        "我没收到。",
        "再发一次。",
        "用最新版。",
        "不要用旧文件。"
      ],
      "events": [
        "对方说“不要用旧文件。”，学习者要听懂后处理。",
        "对方改用“我没收到。”，学习者要能听懂并自然回应。"
      ],
      "roles": "员工 ↔ 主管/同事/人事",
      "task": "正确收发一个文件并确认版本与修改要求。"
    }
  ]
}
