      "id": "pattern_097",
      "number": "097",
      "title": "帮助别人",
      "formula": "主语 + 帮/帮助 + 人 + 动词",
      "introduction": "“帮”更口语，“帮助”稍正式。",
      "example": "我帮你开门。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_118",
      "number": "118",
      "title": "让/叫人做",
      "formula": "主语 + 让/叫 + 人 + 动词",
      "introduction": "表示要求、允许或促使某人做事；“叫”更口语。礼貌邀请另用“请 + 人 + 动词”。",
      "example": "妈妈让我睡觉。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [
        "让/叫"
      ],
      "target": "ai_pattern"
    },
