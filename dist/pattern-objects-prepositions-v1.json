{
  "schema_version": 1,
  "type": "pattern_pack",
  "category_id": "pattern_cat_12",
  "title": "对象、介词与话题",
  "subtitle": "12 个句型",
  "version": 1,
  "updated_at": "2026-08-11T06:20:00Z",
