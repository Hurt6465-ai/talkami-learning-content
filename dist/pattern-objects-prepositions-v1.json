  "items": [
    {
      "id": "pattern_117",
      "number": "117",
      "title": "跟/对某人说",
      "formula": "主语 + 跟/对 + 人 + 说/聊 + 内容",
      "introduction": "“跟”更口语；“对”稍正式，强调说话指向谁。",
      "example": "我跟他说了。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_109",
      "number": "109",
      "title": "使用工具",
      "formula": "主语 + 用 + 工具/方法 + 动词",
      "introduction": "说明用什么东西或方法完成动作。",
      "example": "我用手机学习。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_138",
      "number": "138",
      "title": "感兴趣",
      "formula": "主语 + 对 + 名词 + 感兴趣",
      "introduction": "表示喜欢了解或愿意接触某事。",
      "example": "我对中文感兴趣。",
      "teaching_type": "word_order",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_196",
      "number": "196",
      "title": "对某人某事",
      "formula": "主语 + 对 + 人/事情 + 动词/形容词",
      "introduction": "“对”说明动作、态度或感觉指向谁或什么。",
      "example": "他对我很好。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_235",
      "number": "235",
      "title": "对谁来说",
      "formula": "对 + 人 + 来说，小句",
      "introduction": "从某个人的角度说明情况。",
      "example": "对我来说，这很难。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_423",
      "number": "423",
      "title": "有帮助影响",
      "formula": "名词/事情 + 对 + 人/事 + 有帮助/有影响",
      "introduction": "说明某事会给谁带来帮助或影响。",
      "example": "运动对身体有帮助。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_452",
      "number": "452",
      "title": "按照",
      "formula": "按照 + 规则/方法 + 动词",
      "introduction": "表示照着规定或方法做。",
      "example": "请按照说明操作。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_470",
      "number": "470",
      "title": "某方面",
      "formula": "在 + 名词 + 方面，主语 + 谓语",
      "introduction": "限定讨论的是哪一个方面。",
      "example": "在价格方面，这个更好。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [
        "在"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_485",
      "number": "485",
      "title": "根据",
      "formula": "根据 + 信息/情况 + 动词",
      "introduction": "表示做判断或决定的依据。",
      "example": "根据天气，我们再决定。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_267",
      "number": "267",
      "title": "有无关系",
      "formula": "A + 跟/和 + B + 有/没关系",
      "introduction": "说明两件事有没有联系；不要和回应别人道歉的“没关系”混在一起。",
      "example": "这跟我没关系。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_439",
      "number": "439",
      "title": "替/为别人做",
      "formula": "主语 + 替/为 + 人 + 动词",
      "introduction": "“替”强调代替别人，“为”较正式，也可表示为了某人。",
      "example": "我替他上班。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_222",
      "number": "222",
      "title": "话题先说",
      "formula": "话题 + 主语 + 后面的说明",
      "introduction": "先把要谈的事情放前面，再说明它。",
      "example": "这件事，我同意。",
      "teaching_type": "word_order",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    }
  ]
}
