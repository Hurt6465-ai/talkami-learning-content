{
  "schema_version": 1,
  "type": "pattern_pack",
  "category_id": "pattern_cat_04",
  "title": "否定、能愿与推测",
  "subtitle": "42 个句型",
  "version": 1,
  "updated_at": "2026-08-11T06:20:00Z",
  "item_count": 42,
  "items": [
    {
      "id": "pattern_034",
      "number": "034",
      "title": "一般否定",
      "formula": "主语 + 不 + 动词",
      "introduction": "习惯、意愿、未来常用“不”。",
      "example": "我不喝咖啡。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_035",
      "number": "035",
      "title": "过去否定",
      "formula": "主语 + 没(有) + 动词",
      "introduction": "过去或完成的否定用“没”。",
      "example": "我昨天没上班。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [
        "过"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_036",
      "number": "036",
      "title": "还没……（呢）",
      "formula": "主语 + 还没 + 动词（+呢）",
      "introduction": "表示到现在仍未完成；句末加“呢”可以加强当前语气。",
      "example": "我还没吃饭呢。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [
        "呢"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_037",
      "number": "037",
      "title": "别",
      "formula": "别 + 动词",
      "introduction": "常用口语禁止。",
      "example": "别说话。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_039",
      "number": "039",
      "title": "不要",
      "formula": "不要 + 动词",
      "introduction": "比“别”稍完整。",
      "example": "不要着急。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_040",
      "number": "040",
      "title": "不能",
      "formula": "主语 + 不能 + 动词",
      "introduction": "能力、条件或规定不允许。",
      "example": "我今天不能去。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_041",
      "number": "041",
      "title": "不会",
      "formula": "主语 + 不会 + 动词",
      "introduction": "表示不会某技能，也可表示推测。",
      "example": "我不会游泳。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_042",
      "number": "042",
      "title": "不想",
      "formula": "主语 + 不想 + 动词",
      "introduction": "否定愿望。",
      "example": "我不想出去。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_043",
      "number": "043",
      "title": "会技能",
      "formula": "主语 + 会 + 技能动词",
      "introduction": "表示学会的技能。",
      "example": "我会开车。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_044",
      "number": "044",
      "title": "能能力",
      "formula": "主语 + 能 + 动词",
      "introduction": "表示客观能力或条件。",
      "example": "你能帮我吗？",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_045",
      "number": "045",
      "title": "可以许可",
      "formula": "主语 + 可以 + 动词",
      "introduction": "表示允许或条件许可。",
      "example": "你可以进来。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_046",
      "number": "046",
      "title": "要需求",
      "formula": "主语 + 要 + 名词",
      "introduction": "点餐购物高频。",
      "example": "我要一杯水。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_050",
      "number": "050",
      "title": "要计划",
      "formula": "主语 + 要 + 动词",
      "introduction": "表示意愿、计划或即将。",
      "example": "我要回家。",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_051",
      "number": "051",
      "title": "可以…吗",
      "formula": "主语 + 可以 + 动词 + 吗",
      "introduction": "请求许可。",
      "example": "我可以坐这里吗？",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [
        "吗"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_052",
      "number": "052",
      "title": "要不要",
      "formula": "主语 + 要不要 + 名词/动词",
      "introduction": "提供选择或建议。",
      "example": "你要不要喝水？",
      "teaching_type": "function_word",
      "difficulty": "easy",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_209",
      "number": "209",
      "title": "会可能",
      "formula": "主语 + 会 + 动词（推测/将来）",
      "introduction": "表示将来可能发生某件事。",
      "example": "明天会下雨。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_211",
      "number": "211",
      "title": "应该",
      "formula": "主语 + 应该 + 动词",
      "introduction": "建议或义务。",
      "example": "你应该休息。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_212",
      "number": "212",
      "title": "必须",
      "formula": "主语 + 必须 + 动词",
      "introduction": "表示一定要做，语气比较强。",
      "example": "你必须完成作业。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_214",
      "number": "214",
      "title": "得必须",
      "formula": "主语 + 得 + 动词",
      "introduction": "口语中的“必须”，读děi。",
      "example": "我得走了。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [
        "得"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_216",
      "number": "216",
      "title": "想要",
      "formula": "主语 + 想要 + 名词",
      "introduction": "比“想+动词”更常接名词。",
      "example": "我想要这个。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_217",
      "number": "217",
      "title": "愿意",
      "formula": "主语 + 愿意 + 动词",
      "introduction": "明确表示意愿。",
      "example": "我愿意帮你。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_237",
      "number": "237",
      "title": "一定",
      "formula": "主语 + 一定 + 动词/形容词",
      "introduction": "表示强烈要求或推断。",
      "example": "你一定要来。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_238",
      "number": "238",
      "title": "最好",
      "formula": "主语 + 最好 + 动词",
      "introduction": "委婉但明确的建议。",
      "example": "你最好早点睡。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_239",
      "number": "239",
      "title": "能不能",
      "formula": "主语 + 能不能 + 动词",
      "introduction": "高频请求和商量。",
      "example": "你能不能说慢一点？",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_384",
      "number": "384",
      "title": "不再",
      "formula": "主语 + 不再 + 动词",
      "introduction": "表示以后停止。",
      "example": "我不再等了。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [
        "再"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_385",
      "number": "385",
      "title": "不愿意",
      "formula": "主语 + 不愿意 + 动词",
      "introduction": "比“不想”更强调态度。",
      "example": "他不愿意道歉。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_386",
      "number": "386",
      "title": "敢",
      "formula": "主语 + 敢 + 动词",
      "introduction": "表示有没有勇气。",
      "example": "你敢试吗？",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_387",
      "number": "387",
      "title": "不一定",
      "formula": "主语 + 不一定 + 动词/形容词",
      "introduction": "否定必然性。",
      "example": "贵的不一定好。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_167",
      "number": "167",
      "title": "不怎么……",
      "formula": "主语 + 不怎么 + 动词/形容词",
      "introduction": "委婉表示频率低、程度不高或不太喜欢。",
      "example": "我不怎么喝酒。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_026",
      "number": "026",
      "title": "完全否定强调",
      "formula": "一点儿也不/都不 + 形容词/动词；一点儿也没/都没 + 动词",
      "introduction": "强调完全不、完全没有。“没”通常否定动作或变化，不直接否定普通形容词。",
      "example": "我一点儿也不累。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_200",
      "number": "200",
      "title": "从来不/从来没",
      "formula": "主语 + 从来不 + 动词 / 从来没 + 动词 + 过",
      "introduction": "“从来不”说一贯习惯；“从来没……过”否定过去经历。",
      "example": "我从来没去过北京。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [
        "过",
        "从/到"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_257",
      "number": "257",
      "title": "一个也不/一点也没",
      "formula": "一 + 量词/疑问词 + 也/都 + 不/没 + 谓语",
      "introduction": "强调数量为零或完全没有。",
      "example": "一个人也没来。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_215",
      "number": "215",
      "title": "该……了",
      "formula": "主语 + 该 + 动词 + 了",
      "introduction": "表示时间到了，应该开始做某事。",
      "example": "我们该走了。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_213",
      "number": "213",
      "title": "非……不可",
      "formula": "主语 + 非 + 动词 + 不可",
      "introduction": "表示必须做、决心很强；也可用问句表示不理解对方为何坚持。",
      "example": "你非去不可吗？",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_218",
      "number": "218",
      "title": "可能和也许",
      "formula": "可能/也许 + 小句",
      "introduction": "都表示不确定；“可能”更中性，“也许”更口语、主观。",
      "example": "也许他忘了。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_219",
      "number": "219",
      "title": "好像",
      "formula": "主语 + 好像 + 小句/形容词",
      "introduction": "根据感觉作不确定判断，比“可能”更像说话人的观察。",
      "example": "他好像生病了。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_221",
      "number": "221",
      "title": "说不定",
      "formula": "说不定 + 小句",
      "introduction": "很口语，表示某件事也许会发生。",
      "example": "说不定他会来。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_210",
      "number": "210",
      "title": "会……的",
      "formula": "主语 + 会 + 动词 + 的",
      "introduction": "表示有把握的推测、安慰或保证。",
      "example": "放心吧，他会来的。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_220",
      "number": "220",
      "title": "恐怕",
      "formula": "恐怕 + 小句",
      "introduction": "表示担心某种不太好的可能，也可委婉拒绝。",
      "example": "恐怕今天不行。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_256",
      "number": "256",
      "title": "都不",
      "formula": "复数主语/范围 + 都不 + 动词",
      "introduction": "表示范围里的每一个都不做。",
      "example": "我们都不喝酒。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_284",
      "number": "284",
      "title": "也不",
      "formula": "主语 + 也不 + 动词/形容词",
      "introduction": "表示和前面的否定情况一样。",
      "example": "我也不去。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_466",
      "number": "466",
      "title": "不都",
      "formula": "复数主语/范围 + 不都 + 动词",
      "introduction": "表示不是全部都这样，只否定一部分。",
      "example": "我们不都住这里。",
      "teaching_type": "function_word",
      "difficulty": "medium",
      "focus_tags": [],
      "target": "ai_pattern"
    }
  ]
}
