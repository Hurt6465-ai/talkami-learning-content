{
  "schema_version": 1,
  "type": "pattern_pack",
  "category_id": "pattern_cat_15",
  "title": "高频话语标记",
  "subtitle": "18 个句型",
  "version": 1,
  "updated_at": "2026-08-11T06:20:00Z",
  "item_count": 18,
  "items": [
    {
      "id": "pattern_139",
      "number": "139",
      "title": "听说",
      "formula": "听说 + 小句",
      "introduction": "说明信息是从别人那里听来的。",
      "example": "听说他结婚了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_198",
      "number": "198",
      "title": "没想到",
      "formula": "没想到 + 小句",
      "introduction": "表示结果出乎预料。",
      "example": "没想到他来了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "从/到",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_236",
      "number": "236",
      "title": "看来",
      "formula": "看来/看样子 + 小句",
      "introduction": "根据眼前情况作判断。",
      "example": "看来要下雨了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_199",
      "number": "199",
      "title": "怪不得/难怪",
      "formula": "怪不得/难怪 + 小句，原来 + 原因",
      "introduction": "知道原因后表示恍然大悟。",
      "example": "难怪他没来，原来病了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "得",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_392",
      "number": "392",
      "title": "说……就……",
      "formula": "主语 + 说 + 动词 + 就 + 动词",
      "introduction": "表示动作突然、干脆，或事情变化很快。",
      "example": "他说走就走。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "就",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_393",
      "number": "393",
      "title": "差点儿",
      "formula": "主语 + 差点儿（就）+ 动词（了） / 差点儿没 + 动词",
      "introduction": "前一种通常表示事情几乎发生但最后没发生；“差点儿没……”常表示好结果险些没实现、最后实现了，具体仍要看语境。",
      "example": "我差点儿迟到。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "了",
        "就",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_186",
      "number": "186",
      "title": "其实",
      "formula": "其实 + 小句",
      "introduction": "用来说明真实情况，常和别人想的不一样。",
      "example": "其实我知道。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_189",
      "number": "189",
      "title": "后来",
      "formula": "后来 + 小句",
      "introduction": "说明一段时间以后发生的事。",
      "example": "后来他回来了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_224",
      "number": "224",
      "title": "结果",
      "formula": "结果 + 小句",
      "introduction": "直接说事情最后变成什么样。",
      "example": "结果我们输了。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_225",
      "number": "225",
      "title": "比如",
      "formula": "比如 + 名词/小句",
      "introduction": "用一个或几个例子帮助说明。",
      "example": "我喜欢水果，比如苹果。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "比",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_286",
      "number": "286",
      "title": "本来",
      "formula": "主语 + 本来 + 小句",
      "introduction": "说明原来的情况、计划或应该的情况。",
      "example": "我本来想去。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_390",
      "number": "390",
      "title": "反正",
      "formula": "反正 + 小句",
      "introduction": "表示不管前面怎样，结论都一样。",
      "example": "反正我不去。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_489",
      "number": "489",
      "title": "倒是",
      "formula": "主语 + 倒是 + 后面的说明",
      "introduction": "表示和预想不同，或先肯定一点再补充。",
      "example": "他倒是很安静。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_337",
      "number": "337",
      "title": "特别强调一项",
      "formula": "特别是/尤其是 + 名词/小句",
      "introduction": "从一组内容中突出最需要注意的一项。",
      "example": "我喜欢水果，尤其是苹果。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_187",
      "number": "187",
      "title": "说实话/老实说",
      "formula": "说实话/老实说 + 小句",
      "introduction": "先说明接下来要说真实想法，也常用于委婉表达不同意见。",
      "example": "说实话，我不喜欢。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_188",
      "number": "188",
      "title": "对了",
      "formula": "对了，+ 小句",
      "introduction": "突然想起一件事，或自然转换话题。",
      "example": "对了，你明天去吗？",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "了",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_207",
      "number": "207",
      "title": "好不容易才",
      "formula": "主语 + 好不容易才 + 动词",
      "introduction": "强调经过很多困难或等待，最后才做到。",
      "example": "我好不容易才买到票。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "才",
        "口语场景"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_391",
      "number": "391",
      "title": "动不动就……",
      "formula": "主语 + 动不动就 + 动词",
      "introduction": "表示很容易或经常出现某种情况，常带不满。",
      "example": "他动不动就生气。",
      "teaching_type": "discourse",
      "difficulty": "easy",
      "focus_tags": [
        "就",
        "口语场景"
      ],
      "target": "ai_pattern"
    }
  ]
}
