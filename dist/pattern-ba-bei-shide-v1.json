  "items": [
    {
      "id": "pattern_347",
      "number": "347",
      "title": "把字句基本结构",
      "formula": "主语 + 把 + 宾语 + 动词 + 结果/地点/数量等",
      "introduction": "“把”把明确宾语提前；动词后通常还要有结果、地点、数量或动态成分。",
      "example": "请把门关上。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_231",
      "number": "231",
      "title": "“是……的”问句",
      "formula": "主语 + 是 + 谁/怎么/在哪儿/什么时候 + 动词 + 的",
      "introduction": "询问已经发生事情的施事、方式、地点或时间。",
      "example": "你是怎么来的？",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "在"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_349",
      "number": "349",
      "title": "“是……的”强调",
      "formula": "主语 + 是 + 时间/地点/方式/人物 + 动词 + 的",
      "introduction": "用于已经发生的事情，强调时间、地点、方式或做事的人。",
      "example": "我是昨天来的。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_482",
      "number": "482",
      "title": "强调原因或目的",
      "formula": "主语 + 是因为/为了 + 原因/目的 + 才 + 动词 + 的",
      "introduction": "用“是……的”突出做事的原因或目的。",
      "example": "我是为了你才来的。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "了",
        "才"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_344",
      "number": "344",
      "title": "把字位置",
      "formula": "主语 + 把 + 宾语 + 动词 + 在/到 + 地点",
      "introduction": "说明处理以后东西到了哪里。",
      "example": "我把书放在桌上。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把",
        "在",
        "从/到"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_355",
      "number": "355",
      "title": "是不是强调",
      "formula": "主语 + 是不是 + 强调部分 + 动词 + 的",
      "introduction": "询问已发生事情的时间、地点、方式等。",
      "example": "你是不是坐车来的？",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_369",
      "number": "369",
      "title": "把字给予",
      "formula": "主语 + 把 + 宾语 + 动词 + 给 + 人",
      "introduction": "说明把某物处理后给了谁。",
      "example": "我把礼物送给他。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把",
        "给"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_396",
      "number": "396",
      "title": "把字句的完成",
      "formula": "主语 + 把 + 明确宾语 + 动词 + 了",
      "introduction": "“了”可以使把字句完整，但初学时优先使用“关上、写完、放好”等结果补语更自然。",
      "example": "我把饭吃了。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把",
        "了"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_397",
      "number": "397",
      "title": "把字变成",
      "formula": "主语 + 把 + 宾语 + 动词 + 成 + 结果",
      "introduction": "说明处理后变成什么。",
      "example": "他把水冻成冰。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_420",
      "number": "420",
