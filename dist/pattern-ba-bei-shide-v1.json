      "example": "把书拿过来。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_445",
      "number": "445",
      "title": "把字短动作",
      "formula": "主语 + 把 + 宾语 + 动词 + 一下",
      "introduction": "用于礼貌、短暂地处理某物。",
      "example": "请把门开一下。",
      "teaching_type": "function_word",
      "difficulty": "hard",
      "focus_tags": [
        "把"
      ],
      "target": "ai_pattern"
    },
    {
      "id": "pattern_447",
      "number": "447",
